<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Bluetooth: discovery + connection. No INTERNET permission on purpose:
         SignalBridge moves voice over local radio only, never over mobile data. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Microphone for voice capture -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Foreground service so a live voice link survives the screen turning off -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- EXPERIMENTAL cellular-bridge module only (see bridge/CellularBridge.kt).
         Declared but the feature is opt-in and off by default. -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_action_call"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SignalBridge">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".session.VoiceLinkService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
